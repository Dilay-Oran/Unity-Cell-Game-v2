      m_Calls: []
  m_text: "\t\t\xC7ekirdek\n1. Madde al\u0131\u015Fveri\u015Fi a\xE7\u0131kl\u0131klar
    sayesinde ger\xE7ekle\u015Fir.\n2. B\xF6l\xFCnme, oran\u0131m, enerji \xFCretimi
    gibi olaylar\u0131n y\xF6netim ve denetimini  yapan merkezdir\n3. Kromatin iplik
    b\xF6l\xFCnme s\u0131ras\u0131nda kromozomlar\u0131 olu\u015Fturur.\n4. Kromozomlar\u0131
    olu\u015Fturan en \xF6nemli yap\u0131 maddesi gen molek\xFClleridir\n5.Genler,
    DNA molek\xFCl\xFC \xFCzerindeki kal\u0131tsal birimlerdir\n"
  m_isRightToLeft: 0
